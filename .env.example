# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.<proje-id>:<sifre>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Upstash Redis -- REST arayuzu KULLANILIYOR (protokol-tabanli
# rediss://... bağlantı dizesi bu projede OKUNMUYOR, bkz.
# pipeline/rag_cache.py + api/main.py::health_check() G3 notu).
UPSTASH_REDIS_REST_URL=https://<endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>

# Storage / generated artifacts
GBMAID_NAS_ROOT=<UNC-or-local-NAS-root>
GBMAID_PROCESSED_ROOT=<local-output-root>
GBMAID_RESAMPLED_ROOT=<local-output-root>
GBMAID_ZSCORE_STATS_PATH=<local-json-path>

# New-patient demo only; keep disabled until pretrained-model validation passes
nnUNet_raw=<local-nnunet-raw-root>
nnUNet_preprocessed=<local-nnunet-preprocessed-root>
nnUNet_results=<local-nnunet-results-root>
GBMAID_NNUNET_DATASET=Dataset002_BRATS19
GBMAID_NNUNET_CONFIGURATION=3d_fullres
GBMAID_NNUNET_TRAINER=nnUNetTrainer
GBMAID_NNUNET_PLANS=nnUNetPlans
GBMAID_ENABLE_NEW_PATIENT_NNUNET=0

# App
ENVIRONMENT=development

# Minimal Auth stub (G2, Hafta 5 kapanışı) -- tanımlıysa TÜM endpoint'ler
# `X-API-Key` header'ı ister (eşleşmezse 401). Tanımsız/boş bırakılırsa
# auth DEVRE DIŞI kalır (geliştirme modu) -- bu davranış api/main.py'de
# uygulama başlarken AÇIKÇA loglanır.
GBMAID_API_KEY=


# ===========================================================================
# LLM -- RAG literatur ozeti (Hafta 5) | 2026-09-14, rag-agent-P5
# ===========================================================================
# VARSAYILAN KAPALI. Bu blok bos/false birakildigi surece sistem bugunku
# haliyle BIREBIR ayni calisir: literatur getirilir, kaynaklarin orijinal
# abstract'lari yanitta doner, ama DIL MODELI OZETI URETILMEZ.
#
# KURULUM -- Baris tek seferde uygular (5 adim, sirasi ONEMLI):
#   1) Saglayiciyi sec:  GBMAID_LLM_PROVIDER=openai   VEYA   anthropic
#   2) SDK'yi kur:       pip install openai           VEYA   pip install anthropic
#   3) Model surumunu yaz: GBMAID_LLM_MODEL=<SABIT surum kimligi>
#      !! Icinde "latest" gecen her ad REDDEDILIR (yeniden uretilebilirlik:
#         rapora hangi model surumuyle kosuldugu yazilacak).
#      !! OpenAI'de tarihli snapshot kullanilir (or. ...-2024-08-06).
#         Anthropic'te model kimlikleri ZATEN sabittir ve tarih soneki
#         ALMAZ (or. claude-opus-5) -- bunlara tarih EKLENMEZ.
#   4) SECILEN saglayicinin anahtarini asagiya yapistir (PROJE KOKUNDEKI
#      .env dosyasina -- bu ornek dosyaya DEGIL, gbm-aid mert/.env'ye DEGIL).
#   5) EN SON: GBMAID_LLM_ENABLED=true
#
# Dogrulama (anahtari yazdiktan sonra, "gbm-aid mert" icinden):
#   python -m pytest tests/test_llm_provider.py tests/test_rag_llm.py #                    tests/test_rag_pipeline.py -q
GBMAID_LLM_ENABLED=false
GBMAID_LLM_PROVIDER=
GBMAID_LLM_MODEL=

# Saglayici anahtarlari -- YALNIZ SECILEN saglayicininki doldurulur.
# Bu degerler hicbir log/yanit/exception mesajina GIRMEZ (kod anahtari
# dataclass'ta SAKLAMAZ, yalnizca degisken ADINI tasir).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Muhafazakar sinirlar -- bos birakilirsa koddaki varsayilan kullanilir.
# (Ege'nin hesabinda 10 USD SERT LIMIT var; bu degerler ona gore secildi.)
# Aralik disi bir deger SESSIZCE KIRPILMAZ, hata verir.
GBMAID_LLM_TIMEOUT_SECONDS=60        # 1-600   (varsayilan 60)
GBMAID_LLM_MAX_RETRIES=1             # 0-5     (varsayilan 1  = en fazla 2 deneme)
GBMAID_LLM_MAX_OUTPUT_TOKENS=900     # 64-8192 (varsayilan 900)
# Asagidaki ikisi BOS BIRAKILMALIDIR (varsayilan davranis):
#   TEMPERATURE bos ise istege HIC eklenmez -- bazi guncel modeller bu
#   parametreyi reddediyor (HTTP 400).
#   EFFORT yalnizca anthropic icin anlamlidir (dusunme derinligi/maliyet).
GBMAID_LLM_TEMPERATURE=
GBMAID_LLM_EFFORT=
