# =============================================================================
# GBM-AID -- SUNUCU (.env) SABLONU
# =============================================================================
# 🔴 BU DOSYA BIR SABLONDUR, GERCEK DEGER ICERMEZ ve icermemelidir.
#    Sunucuda `/opt/gbmaid/.env` olarak OLUSTURULUR ve depoya ASLA girmez
#    (`.gitignore` `.env`'i zaten disarida tutar).
#
# Kullanim:
#    cp deploy/env.sunucu.ornek /opt/gbmaid/.env
#    nano /opt/gbmaid/.env          # <...> yer tutucularini doldur
#    chmod 600 /opt/gbmaid/.env     # yalniz sahibi okuyabilsin
#
# ⚠️ Degerlerin cogu gelistirme makinesindeki `.env` ile AYNIDIR. Barış'in
#    2026-09-16 karari geregi Supabase ve OpenAI kimlik bilgileri
#    DONDURULMEYECEK (K9), yani mevcut degerler aynen kullanilir.
# =============================================================================

# --- Veritabani (Supabase) ---------------------------------------------------
# `tools/data_integrity_check.py` once bu bes degiskene, sonra DATABASE_URL'e
# bakar. Ikisini de doldur.
SUPABASE_HOST=<supabase-host>
SUPABASE_PORT=<port>
SUPABASE_DB=<veritabani-adi>
SUPABASE_USER=<kullanici>
SUPABASE_PASSWORD=<sifre>
DATABASE_URL=<postgresql-baglanti-dizesi>

# --- MR goruntu kokleri ------------------------------------------------------
# 🔴 SUNUCUDA FARKLI: gelistirme makinesinde bunlar Tailscale NAS'i ve yerel
#    diski gosteriyordu; sunucuda kopyalanan dizinleri gosterir.
#
# Icerik: upenn-gbm/ lumiere/ tcga-gbm/  (toplam ~5,61 GB)
GBMAID_NAS_ROOT=/srv/gbmaid/nas
#
# UCSF NAS'ta DEGILDIR, kendi kokunde durur (~0,86 GB). Icinde dogrudan
# `UCSF-PDGM-XXXX_nifti/` klasorleri olmalidir.
# ⚠️ Tanimlanmazsa GBMAID_NAS_ROOT'a duser -- UCSF'i NAS kokunun ALTINA
#    koyarsan bu satiri silebilirsin.
GBMAID_UCSF_ROOT=/srv/gbmaid/ucsf

# --- Model artefakti ---------------------------------------------------------
# Depodan gelir; yol MUTLAK olmalidir.
GBMAID_COX_CHECKPOINT_PATH=/opt/gbmaid/backend/models/cox_phm_v3b_lowvar_v2amgmt_2026-09-12.pkl

# --- Onbellek (Upstash Redis, REST) -----------------------------------------
UPSTASH_REDIS_REST_URL=<upstash-rest-url>
UPSTASH_REDIS_REST_TOKEN=<upstash-token>

# --- PubMed --------------------------------------------------------------- --
NCBI_API_KEY=<ncbi-anahtari>

# --- Dil modeli (literatur ozeti) -------------------------------------------
# ⚠️ GBMAID_LLM_ENABLED=1 iken `/analyze_patient` her cagrida OpenAI'a gider.
#    Site SIFRESIZ oldugu icin (Barış karari, 2026-09-16) bu uc noktayi herkes
#    cagirabilir -> OpenAI hesabinda AYLIK HARCAMA LIMITI tanimla.
GBMAID_LLM_ENABLED=1
GBMAID_LLM_PROVIDER=<saglayici>
GBMAID_LLM_MODEL=<model-adi>
OPENAI_API_KEY=<openai-anahtari>
GBMAID_LLM_TIMEOUT_SECONDS=<saniye>
GBMAID_LLM_MAX_RETRIES=<adet>
GBMAID_LLM_MAX_OUTPUT_TOKENS=<adet>
GBMAID_LLM_TEMPERATURE=<deger>
GBMAID_LLM_EFFORT=<deger>

# --- API anahtari ------------------------------------------------------------
# 🔴 BILINCLI OLARAK TANIMSIZ BIRAKILIYOR (Barış karari 2026-09-16: site
#    SIFRESIZ). `api/main.py::_is_authorized()` bu degisken yoksa her istege
#    izin verir. Siteyi kapatmak istersen:
#      1) buraya bir deger yaz,
#      2) Caddyfile'daki `header_up X-API-Key` satirinin yorumunu kaldir.
#    Anahtar tarayiciya GOMULMEZ -- ters vekil ekler.
# GBMAID_API_KEY=<anahtar>
