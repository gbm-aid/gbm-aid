# 2026-09-16: Linux sunucuda calisan dosyalar LF olmak ZORUNDA.
# Windows'ta `core.autocrlf` acik oldugu icin (bu makinede oyle) bunlar
# CRLF'e cevrilirse Linux'ta kirilirlar:
#   *.sh   -> `bash: $'\r': command not found`
#   systemd birimi ve Caddyfile -> ayristirma hatasi
*.sh              text eol=lf
deploy/Caddyfile  text eol=lf
*.service         text eol=lf

# Ikili dosyalar hic dokunulmasin.
*.pkl   binary
*.png   binary
*.index binary
*.nii   binary
*.gz    binary
